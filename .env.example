# Hosted API. Keep populated values in Railway/Doppler, never in this file.
DATABASE_URL=postgresql://trocode:replace_with_local_password@127.0.0.1:54320/trocode?sslmode=disable
PORT=8080
TROCODE_DATABASE_POOL_MAX=10
TROCODE_SESSION_TOKEN_HMAC_KEY=
TROCODE_SESSION_DURATION_DAYS=30
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OPENAI_API_KEY=
TROCODE_AGENT_MODEL=gpt-5.6-luna

# Optional server-hosted admin dashboard at /source/admin.
TROCODE_ADMIN_ACCESS_TOKEN=
# Set a distinct 32+ character value. The session HMAC fallback exists only for
# migration compatibility with codes created by the former Node admin service.
TROCODE_ACCESS_CODE_ENCRYPTION_KEY=

# Paid-call admission and accounting.
TROCODE_PAID_CALLS_ENABLED=true
TROCODE_RESERVATION_TTL_MS=120000
TROCODE_REALTIME_CALL_ESTIMATE_MICRO_USD=5000
TROCODE_SPEECH_MICRO_USD_PER_THOUSAND_CHARACTERS=60000
TROCODE_TRANSCRIPTION_MICRO_USD_PER_MINUTE=4500

# Optional speech provider.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Knowledge API and worker. Use a private bucket without public access/listing.
TROCODE_KNOWLEDGE_SPACES_ENABLED=false
TROCODE_KNOWLEDGE_S3_ACCESS_KEY_ID=
TROCODE_KNOWLEDGE_S3_SECRET_ACCESS_KEY=
TROCODE_KNOWLEDGE_S3_BUCKET=
TROCODE_KNOWLEDGE_S3_REGION=
TROCODE_KNOWLEDGE_S3_ENDPOINT=
TROCODE_KNOWLEDGE_S3_FORCE_PATH_STYLE=false
TROCODE_WORKER_POLL_MS=1000
TROCODE_WORKER_LEASE_SECONDS=120
TROCODE_WORKER_EXTRACTION_PARALLELISM=2

# Desktop. Production API URLs must use HTTPS. The device token is for
# controlled development only; normal users obtain one through Google sign-in.
TROCODE_API_BASE_URL=http://127.0.0.1:8080
TROCODE_DEVICE_SESSION_TOKEN=
TROCODE_UPDATE_ENDPOINT=
TROCODE_UPDATE_PUBLIC_KEY=

# Local PostgreSQL container.
TROCODE_POSTGRES_PASSWORD=

# Tauri release secrets belong in Doppler/GitHub Actions.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
TROCODE_MACOS_SIGNING_IDENTITY=
TROCODE_APPLE_API_KEY=
TROCODE_APPLE_API_KEY_ID=
TROCODE_APPLE_API_ISSUER=
TROCODE_WINDOWS_CERTIFICATE_FILE=
TROCODE_WINDOWS_CERTIFICATE_PASSWORD=
