FROM rust:1.95.0-bookworm AS build
WORKDIR /workspace
COPY . .
RUN cargo build --locked --release -p tro-worker

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /workspace/target/release/tro-worker /usr/local/bin/tro-worker
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/tro-worker"]
