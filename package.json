{
  "name": "trocode",
  "productName": "TroCode",
  "version": "0.1.0",
  "description": "A general-purpose, goal-driven desktop agent powered by CUA.",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "doppler run --project tro-app --config dev -- npm exec -- electron-forge start",
    "package": "doppler run --project tro-app --config dev -- npm exec -- electron-forge package",
    "make": "doppler run --project tro-app --config dev -- npm exec -- electron-forge make",
    "publish": "doppler run --project tro-app --config dev -- npm exec -- electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "membership:keygen": "node scripts/membership-codes.mjs keygen",
    "membership:issue": "node scripts/membership-codes.mjs issue",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "keywords": [
    "ai-agent",
    "computer-use",
    "cua",
    "electron"
  ],
  "author": {
    "name": "Duc Ng",
    "email": "danielbaker06072001@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "@vitest/coverage-v8": "^4.1.10",
    "css-loader": "^6.11.0",
    "dotenv": "^17.4.2",
    "electron": "43.4.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@trycua/cua-driver": "^0.19.3",
    "electron-squirrel-startup": "^1.0.1",
    "posthog-node": "^5.49.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  }
}
